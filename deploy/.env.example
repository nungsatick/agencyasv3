# Copy to .env and fill in. Never commit the real .env.

# Database password (any long random string; letters and digits only keeps the URL simple)
DB_PASSWORD=

# Secret used to sign sessions and encrypt 2FA secrets. Long and random; changing it later
# signs everyone out AND makes every stored 2FA secret unreadable (all users must set 2FA up again).
PAYLOAD_SECRET=

# Public address of the site, no trailing slash. Used in activation / password links.
SITE_URL=https://agencyas.gdcatalog.go.th

# Only used on the very first start, when there are no accounts yet: creates this central admin
# and prints a one-time activation link in the web container's log. Leave empty afterwards.
FIRST_ADMIN_USERNAME=
FIRST_ADMIN_NAME=

# Local port the app listens on (nginx proxies to it)
WEB_PORT=3000
