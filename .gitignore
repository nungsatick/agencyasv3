# web app: dependencies, build output, secrets and uploaded files are also listed in web/.gitignore
web/node_modules/
web/.next/
web/storage/
web/.env
web/tsconfig.tsbuildinfo

# files from the old site (4.2 GB): back up separately, rebuilt from migration/manifest.json
migration/files/

# original province pictures; the site uses 76province_hero/
image76/

# user manual made outside this project
docs/manual/

# Python, Office lock files, OS files
__pycache__/
*.pyc
~$*
.DS_Store
Thumbs.db
desktop.ini

# also listed in docs/DEPLOY.md: the server's real settings, raw pages saved from the old site
deploy/.env
# server configuration (decided 2026-10-26): kept on the dev machine and the server, not in git, so a
# git pull never changes the running setup. Copy them over by hand (docs/SERVER_INSTALL.md step 1).
deploy/docker-compose.yml
deploy/docker-compose.override.yml
deploy/nginx.conf
deploy/backup.sh
crawl/raw/

# province boundaries downloaded for migration/build_thai_map.py (the built paths are in web/src/lib/thaiMapPaths.ts)
migration/geo/

# Claude Code app settings for this machine (how to start the dev server); not part of the project
.claude/

# kept on this machine only: old and unused pictures, design drafts, editor settings, and a copy of the
# province seals (the site and migration/build_import.py use web/public/logos/)
assets/hero-old/
assets/login/
docs/design/
web/.vscode/
76province_logo/

# data exported for the server (content.sql): copy it over, never commit it
deploy-export/
